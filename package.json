{
  "name": "react-pic-gallery",
  "version": "2.0.3",
  "description": "Small, accessible React image gallery and lightbox.",
  "author": "marcelrsoub",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcelrsoub/react-pic-gallery.git"
  },
  "type": "module",
  "module": "./dist/react-pic-gallery.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-pic-gallery.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "dev": "npm run dev:docs",
    "dev:library": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "npm run preview:docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:demo": "npm run build:docs",
    "dev:docs": "astro dev --config docs-site/astro.config.mjs",
    "build:docs": "astro build --config docs-site/astro.config.mjs",
    "preview:docs": "astro preview --config docs-site/astro.config.mjs",
    "github-pages": "npm run build:docs && gh-pages -d build --dotfiles",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@astrojs/react": "^6.0.6",
    "@astrojs/starlight": "^0.42.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "astro": "^7.3.3",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  }
}
